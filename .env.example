# Optional local defaults for the OpenClaw chat page.
# The UI still lets the user edit these values in the terminal panel.
# ── Frontend (Vite) ──────────────────────────
VITE_OPENCLAW_GATEWAY_URL="wss://agentepv-production.up.railway.app"
VITE_OPENCLAW_SESSION_KEY="main"
VITE_OPENCLAW_AUTO_CONNECT="true"

# ── Netlify Function (chat-proxy) ─────────────
VITE_OPENCLAW_USE_PROXY="true"          # ativa modo proxy no frontend
VITE_OPENCLAW_CHAT_PROXY="/.netlify/functions/chat-proxy"

# Configurar no painel Netlify (não versionar):
OPENCLAW_GATEWAY_URL="wss://agentepv-production.up.railway.app"
OPENCLAW_GATEWAY_TOKEN="cole-o-token-aqui"
